    "from math import floor\n",
    "from random import random\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def tirage():\n",
    "    d1=floor(6*random()+1)   \n",
    "    d2=floor(6*random()+1)  \n",
    "    return d1+d2 -1          \n",
    "\n",
    "x = np.arange(0,12)+1\n",
    "f = np.zeros(12)\n",
    "n=10000                       \n",
    "for i in range(n):        \n",
    "    f[tirage() ] += 1\n",
    "f=f/n                      \n",
    "\n",
    "plt.plot( x, f, 'o' )   \n",
    "plt.vlines( x, 0, f )   \n",
    "plt.ylim( bottom=0 ) \n",
    "plt.title(\"Loi de probabilité d'une variable aléatoire discrète\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
